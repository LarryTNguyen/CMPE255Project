    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "folder = Path(\".\\Datasets\\Citibike\")\n",
    "\n",
    "all_files = folder.glob(\"*.csv\")\n",
    "\n",
    "citibike_db = pd.concat(\n",
    "    [pd.read_csv(file) for file in all_files],\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "print(citibike_db.shape)\n",
    "print(citibike_db.head())"
   ]
  },
